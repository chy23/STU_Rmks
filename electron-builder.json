{
  "appId": "com.teacher.sturmks",
  "productName": "學生評語生成系統",
  "copyright": "Copyright © 2026 楊家驊老師 (ChiahuaYang)",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "models",
      "to": "models",
      "filter": ["*.gguf"]
    }
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.education",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "學生評語生成系統"
  }
}
